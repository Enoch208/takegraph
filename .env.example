# Copy to .env and fill in. Never commit .env — see .gitignore.
# Every variable the application reads appears here without a value (§23.3).

# --- Core (§25.1) ---
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+asyncpg://takegraph:takegraph_local@127.0.0.1:5434/takegraph
REDIS_URL=redis://127.0.0.1:6380/0
LOG_LEVEL=INFO
LOG_PROMPTS=false

# --- Auth (§25.2) ---
AUTH_MODE=demo
SESSION_SECRET=
DEMO_SESSION_TTL_SECONDS=3600

# --- Backblaze B2 (§25.3) ---
B2_KEY_ID=
B2_APP_KEY=
B2_REGION=
B2_ENDPOINT_URL=
B2_WORK_BUCKET=
B2_WORK_PREFIX=
B2_RELEASE_KEY_ID=
B2_RELEASE_APP_KEY=
B2_RELEASE_BUCKET=
B2_RELEASE_PREFIX=
B2_EVENT_NOTIFICATIONS_STATUS=unavailable
B2_EVENT_SIGNING_SECRET=
B2_SIGNED_URL_TTL_SECONDS=900
B2_OBJECT_LOCK_MODE=DISABLED
B2_OBJECT_LOCK_RETENTION_DAYS=

# --- Providers (§25.4) ---
GMI_API_KEY=
GMI_IMAGE_MODEL=seedream-5.0-pro
GMI_VIDEO_MODEL=wan2.6-r2v
GMI_VIDEO_FALLBACK_MODEL=pixverse-v5.6-i2v
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_MUSIC_MODEL=music_v2
ELEVENLABS_VOICE_ID=
ANTHROPIC_API_KEY=
EVALUATOR_PROVIDER=anthropic
EVALUATOR_MODEL=

# --- Execution and demo (§25.5) ---
WORKER_ID=takegraph-local-1
WORKER_CONCURRENCY=4
WORK_LEASE_SECONDS=120
WORK_HEARTBEAT_SECONDS=30
RECONCILIATION_INTERVAL_SECONDS=60
MAX_UPLOAD_BYTES=104857600
MAX_VIDEO_DURATION_SECONDS=30
TEMP_WORK_DIR=/tmp/takegraph
ALLOW_FAILURE_INJECTION=false
DEMO_PROJECT_SLUG=orbit-hydration
DEMO_LIVE_RETAKE_DAILY_LIMIT=5
DEMO_LIVE_RETAKE_NODE_KEY=video.clip.03

# --- Feature flags (§25.6) ---
FEATURE_B2_EVENTS=false
FEATURE_OBJECT_LOCK=false
FEATURE_LIVE_DEMO_RETAKE=false
FEATURE_CROSS_PROVIDER_FALLBACK=false
FEATURE_AGENT_REPAIR=false
FEATURE_PUBLIC_RELEASE_PROOF=true
